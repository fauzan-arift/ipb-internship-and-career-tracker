# Project Configuration
PROJECT_NAME=IPB Internship & Career Tracker
VERSION=1.0.0
API_V1_STR=/api/v1

# Security
SECRET_KEY=GANTI_INI_DENGAN_STRING_ACAK_YANG_KUAT_DI_PRODUCTION
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database
# For Docker Compose, use host "db".
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/ipb_internship_tracker
POSTGRES_USER=ipb
POSTGRES_PASSWORD=ipb
POSTGRES_DB=ipb_internship_tracker

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Frontend URL (digunakan di email link)
FRONTEND_URL=http://localhost:5173

# Brevo Email API (https://app.brevo.com/ → API Keys)
BREVO_API_KEY=xkeysib-your-brevo-api-key-here
BREVO_SENDER_EMAIL=noreply@your-domain.com
BREVO_SENDER_NAME=IPB Internship Tracker

# Admin Credentials (untuk seeder & notifikasi email admin)
ADMIN_EMAIL=admin@ipb.ac.id
ADMIN_PASSWORD=GANTI_PASSWORD_INI
ADMIN_FULL_NAME=IPB Admin

# File Upload
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=5
